// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoCliente {
  COMPRADOR
  INQUILINO
  PROPIETARIO
}

enum RolUsuario {
  DIRECTOR
  ASESOR
}

enum TipoInmueble {
  PISO
  CASA
  CHALET
  ATICO
  LOCAL
  GARAJE
  TERRENO
  NAVE
  OFICINA
}

enum TipoOperacion {
  VENTA
  ALQUILER
}

enum EstadoInmueble {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ALQUILADO
}

enum CategoriaArchivo {
  FOTO
  DOCUMENTO
}

// Quién vive en el inmueble. null = «Sin datos».
enum Ocupacion {
  INQUILINOS
  PROPIETARIO
  VACIO
}

// Marca de captación, de menos a más segura. null = sin marca.
// POTENCIAL: podría venderse. NOTICIA: se sabe que el propietario quiere vender.
enum Captacion {
  POTENCIAL
  NOTICIA
}

// Registro de actividad: qué tipo de cosa hizo alguien.
enum AccionActividad {
  ENTRADA // abrió la app (tras 30 min sin usarla)
  ALTA
  CAMBIO
  BAJA // borrado
  CONTACTO // registró una llamada o visita
  OPERACION // cerró una venta o un alquiler
}

// Sobre qué lo hizo.
enum EntidadActividad {
  CLIENTE
  INMUEBLE
  BLOQUE
  CONTACTO
  EVENTO
  ARCHIVO
  INTERES
  OPERACION
  USUARIO
  ZONA
  OFICINA
}

enum TipoEvento {
  VISITA
  REUNION
  LLAMADA
  FIRMA
  OTRO
}

// Cada oficina es un cliente del CRM con sus datos totalmente aislados. Toda
// tabla de negocio lleva oficinaId: la app lo inyecta (lib/db.ts) y los triggers
// crm_misma_oficina impiden enlazar filas de oficinas distintas.
// El default crm_sin_oficina() lanza un error: insertar sin oficina falla.
model Oficina {
  id        String   @id @default(cuid())
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Control de ubicación (lib/lugar.ts): encendido, un asesor solo guarda datos
  // desde una de sus zonas o desde la oficina. Apagado hasta que lo enciende el director.
  controlUbicacion      Boolean   @default(false)
  controlUbicacionDesde DateTime?
  // La oficina en el mapa y cuánto alrededor cuenta como «en la oficina».
  latitud               Float?
  longitud              Float?
  radioMetros           Int       @default(150)
  // Redes de la oficina: una IPv4 («81.32.10.4») o un prefijo IPv6 /64 («2a01:4f8:1:2::/64»).
  redes                 String[]  @default([])

  usuarios     Usuario[]
  clientes     Cliente[]
  inmuebles    Inmueble[]
  bloques      Bloque[]
  contactos    Contacto[]
  eventos      Evento[]
  intereses    Interes[]
  operaciones  Operacion[]
  archivos     Archivo[]
  actividades  Actividad[]
  zonas        Zona[]
  zonaAsesores ZonaAsesor[]
}

// Perfil de un usuario de Supabase Auth (id = auth.users.id). Nunca se borra:
// se desactiva, para conservar la autoría de lo que creó.
model Usuario {
  id                  String     @id
  oficinaId           String     @default(dbgenerated("crm_sin_oficina()"))
  nombre              String
  email               String     @unique
  rol                 RolUsuario @default(ASESOR)
  activo              Boolean    @default(true)
  // Contraseña temporal puesta por el director: hay que cambiarla al entrar.
  debeCambiarPassword Boolean    @default(true)
  // Última petición a la app (se escribe como mucho cada 5 min). Sirve para
  // contar las entradas: 30 min sin usarla y volver es una entrada nueva.
  ultimoAcceso        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  oficina Oficina @relation(fields: [oficinaId], references: [id], onDelete: Restrict)

  clientesCreados    Cliente[]    @relation("ClienteCreadoPor")
  clientesAsignados  Cliente[]    @relation("ClienteAsesor")
  inmueblesCreados   Inmueble[]   @relation("InmuebleCreadoPor")
  inmueblesAsignados Inmueble[]   @relation("InmuebleAsesor")
  bloquesCreados     Bloque[]     @relation("BloqueCreadoPor")
  contactosCreados   Contacto[]   @relation("ContactoCreadoPor")
  eventosCreados     Evento[]     @relation("EventoCreadoPor")
  operacionesCreadas Operacion[]  @relation("OperacionCreadoPor")
  archivosCreados    Archivo[]    @relation("ArchivoCreadoPor")
  interesesCreados   Interes[]    @relation("InteresCreadoPor")
  actividades        Actividad[]  @relation("ActividadCreadoPor")
  zonasCreadas       Zona[]       @relation("ZonaCreadoPor")
  // Zonas que trabaja (solo cuenta para los asesores: el director lo ve todo).
  zonasAsignadas     ZonaAsesor[]

  @@index([oficinaId])
}

// Cita de la agenda. Puede ir ligada a un cliente y/o un inmueble; si se borra
// alguno de ellos el evento se conserva sin el enlace.
// Todo el día: inicio y fin son medianoche UTC y fin es exclusivo (como en iCal).
model Evento {
  id          String     @id @default(cuid())
  oficinaId   String     @default(dbgenerated("crm_sin_oficina()"))
  titulo      String
  tipo        TipoEvento @default(OTRO)
  inicio      DateTime
  fin         DateTime
  todoElDia   Boolean    @default(false)
  notas       String?
  clienteId   String?
  inmuebleId  String?
  creadoPorId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  oficina   Oficina   @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  cliente   Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  inmueble  Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)
  creadoPor Usuario?  @relation("EventoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId, inicio, fin])
  @@index([clienteId])
  @@index([inmuebleId])
}

// Edificio que agrupa pisos. calle + numero + localidad lo identifican de forma
// única dentro de la oficina, lo que permite hacer upsert al importar desde Excel.
model Bloque {
  id           String   @id @default(cuid())
  oficinaId    String   @default(dbgenerated("crm_sin_oficina()"))
  calle        String
  numero       String
  localidad    String
  nombre       String?
  codigoPostal String?
  notas        String?
  // Sus pisos la heredan (trigger Bloque_zona_a_pisos).
  zonaId       String
  creadoPorId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oficina   Oficina    @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  zona      Zona       @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  creadoPor Usuario?   @relation("BloqueCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  inmuebles Inmueble[]

  @@unique([oficinaId, calle, numero, localidad])
  @@index([oficinaId, zonaId])
  @@index([localidad])
}

model Cliente {
  id                   String        @id @default(cuid())
  oficinaId            String        @default(dbgenerated("crm_sin_oficina()"))
  nombre               String
  apellidos            String
  // DNI/NIE normalizado (sin espacios ni guiones, en mayúsculas). Único en la
  // oficina: sirve para detectar duplicados, también al importar desde Excel.
  dni                  String?
  telefono             String?
  email                String?
  direccion            String?
  // Etiquetas del cliente: puede ser a la vez comprador, inquilino y propietario.
  tipos                TipoCliente[] @default([])
  notas                String?
  fechaUltimoContacto  DateTime?
  fechaProximoContacto DateTime?
  // Asesor responsable del cliente; creadoPor es quien lo dio de alta.
  asesorId             String?
  creadoPorId          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  oficina              Oficina     @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  asesor               Usuario?    @relation("ClienteAsesor", fields: [asesorId], references: [id], onDelete: SetNull)
  creadoPor            Usuario?    @relation("ClienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  contactos            Contacto[]
  archivos             Archivo[]
  intereses            Interes[]
  operaciones          Operacion[]
  inmueblesEnPropiedad Inmueble[]  @relation("PropietarioInmueble")
  eventos              Evento[]

  @@unique([oficinaId, dni])
  @@index([oficinaId, createdAt])
  @@index([oficinaId, asesorId])
  @@index([nombre])
  @@index([apellidos])
  @@index([telefono])
  @@index([email])
  @@index([tipos], type: Gin)
  @@index([fechaProximoContacto])
}

// Un contacto puede ser con un cliente, sobre un inmueble, o ambos (p. ej. llamada
// al propietario sobre su piso): así aparece en los dos historiales sin duplicarse.
// La migración añade un CHECK que exige al menos uno de los dos.
model Contacto {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("crm_sin_oficina()"))
  clienteId   String?
  inmuebleId  String?
  fecha       DateTime @default(now())
  nota        String
  creadoPorId String?

  oficina   Oficina   @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  cliente   Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble  Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)
  creadoPor Usuario?  @relation("ContactoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId, fecha])
  @@index([clienteId])
  @@index([inmuebleId])
}

model Inmueble {
  id              String         @id @default(cuid())
  oficinaId       String         @default(dbgenerated("crm_sin_oficina()"))
  referencia      String
  direccion       String
  localidad       String
  tipoInmueble    TipoInmueble
  tipoOperacion   TipoOperacion
  precio          Decimal        @db.Decimal(12, 2)
  metrosCuadrados Int?
  habitaciones    Int?
  banos           Int?
  descripcion     String?
  estado          EstadoInmueble @default(DISPONIBLE)
  propietarioId   String?
  // Asesor responsable del inmueble; creadoPor es quien lo dio de alta.
  asesorId        String?
  creadoPorId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Zona efectiva: la del bloque si está en uno (la copia el trigger
  // Inmueble_hereda_zona), la propia si es un piso suelto.
  zonaId String

  // Ubicación dentro del bloque. planta es entera para poder ordenar (0 = Bajo).
  bloqueId String?
  escalera String?
  planta   Int?
  puerta   String?

  ocupacion            Ocupacion?
  captacion            Captacion?
  fechaUltimoContacto  DateTime?
  // Día en que toca volver a contactar (UTC medianoche), como en Cliente.
  fechaProximoContacto DateTime?
  // Fin del contrato de alquiler vigente (solo fecha).
  fechaFinAlquiler     DateTime?  @db.Date

  oficina     Oficina     @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  propietario Cliente?    @relation("PropietarioInmueble", fields: [propietarioId], references: [id], onDelete: Restrict)
  bloque      Bloque?     @relation(fields: [bloqueId], references: [id], onDelete: Restrict)
  zona        Zona        @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  asesor      Usuario?    @relation("InmuebleAsesor", fields: [asesorId], references: [id], onDelete: SetNull)
  creadoPor   Usuario?    @relation("InmuebleCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  archivos    Archivo[]
  intereses   Interes[]
  operaciones Operacion[]
  contactos   Contacto[]
  eventos     Evento[]

  @@unique([oficinaId, referencia])
  @@index([oficinaId, createdAt])
  @@index([oficinaId, asesorId])
  @@index([oficinaId, fechaFinAlquiler])
  @@index([oficinaId, fechaProximoContacto])
  @@index([oficinaId, captacion])
  @@index([oficinaId, zonaId])
  @@index([bloqueId])
  @@index([bloqueId, escalera, planta, puerta])
  @@index([ocupacion])
  @@index([fechaUltimoContacto])
  @@index([localidad])
  @@index([estado])
  @@index([tipoOperacion])
  @@index([tipoInmueble])
  @@index([propietarioId])
  @@index([localidad, estado, tipoOperacion])
}

model Interes {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("crm_sin_oficina()"))
  clienteId   String
  inmuebleId  String
  fecha       DateTime @default(now())
  creadoPorId String?

  oficina   Oficina  @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble  Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)
  creadoPor Usuario? @relation("InteresCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId])
  @@index([clienteId])
  @@index([inmuebleId])
}

model Operacion {
  id            String        @id @default(cuid())
  oficinaId     String        @default(dbgenerated("crm_sin_oficina()"))
  clienteId     String
  inmuebleId    String
  tipoOperacion TipoOperacion
  fecha         DateTime      @default(now())
  precioFinal   Decimal       @db.Decimal(12, 2)
  notas         String?
  creadoPorId   String?
  createdAt     DateTime      @default(now())

  oficina   Oficina  @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmueble  Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Restrict)
  creadoPor Usuario? @relation("OperacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId, fecha])
  @@index([clienteId])
  @@index([inmuebleId])
}

model Archivo {
  id             String           @id @default(cuid())
  oficinaId      String           @default(dbgenerated("crm_sin_oficina()"))
  categoria      CategoriaArchivo
  clienteId      String?
  inmuebleId     String?
  bucket         String
  path           String
  url            String?
  nombreOriginal String
  tamanioBytes   Int
  mimeType       String
  orden          Int              @default(0)
  creadoPorId    String?
  createdAt      DateTime         @default(now())

  oficina   Oficina   @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  cliente   Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble  Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)
  creadoPor Usuario?  @relation("ArchivoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId])
  @@index([clienteId])
  @@index([inmuebleId])
  @@index([categoria])
  @@index([inmuebleId, categoria, orden])
}

// Registro de actividad de la oficina: qué hizo cada persona y cuándo. Solo lo
// ven los directores y se conserva siempre (la app solo inserta y lee).
// No enlaza a la ficha con una FK: el resumen se guarda como texto porque la
// ficha puede borrarse, y `enlace` es la ruta para abrirla mientras exista.
model Actividad {
  id          String            @id @default(cuid())
  oficinaId   String            @default(dbgenerated("crm_sin_oficina()"))
  // Quién lo hizo (lo pone la extensión de ámbito, como en las demás tablas).
  creadoPorId String?
  fecha       DateTime          @default(now())
  // Día en España, para agrupar y filtrar por días.
  dia         DateTime          @db.Date
  accion      AccionActividad
  entidad     EntidadActividad?
  entidadId   String?
  enlace      String?
  // «Dio de alta GR-2431 · C/ Estrellas 22», sin el nombre de quien lo hizo.
  resumen     String
  // Texto de apoyo, como la nota de un contacto.
  detalle     String?
  // Campos cambiados: [{ campo, antes, despues }], ya formateados.
  cambios     Json?
  // Dónde estaba al guardarlo, con el control de ubicación: «Zaidín»,
  // «Oficina» o «Red de la oficina». Nunca coordenadas.
  lugar       String?

  oficina   Oficina  @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  creadoPor Usuario? @relation("ActividadCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([oficinaId, dia])
  @@index([oficinaId, creadoPorId, dia])
}

// Subzona de la oficina. Cada bloque y cada piso suelto está en una, y cada
// asesor trabaja las suyas: solo ve sus pisos y bloques (lib/zonas.ts).
// Solo el director crea, cambia y borra zonas y reparte a los asesores.
model Zona {
  id          String   @id @default(cuid())
  oficinaId   String   @default(dbgenerated("crm_sin_oficina()"))
  nombre      String
  // Clave de la paleta fija de lib/validations/zona.ts.
  color       String
  notas       String?
  // Contorno dibujado en el mapa: geometría GeoJSON Polygon, en [lng, lat].
  forma       Json?
  creadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oficina   Oficina      @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  creadoPor Usuario?     @relation("ZonaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  asesores  ZonaAsesor[]
  bloques   Bloque[]
  inmuebles Inmueble[]

  @@unique([oficinaId, nombre])
}

// Qué asesores trabajan cada zona (muchos a muchos). Tabla explícita para que
// lleve oficinaId como las demás y la extensión de ámbito la acote.
model ZonaAsesor {
  oficinaId String @default(dbgenerated("crm_sin_oficina()"))
  zonaId    String
  usuarioId String

  oficina Oficina @relation(fields: [oficinaId], references: [id], onDelete: Restrict)
  zona    Zona    @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([zonaId, usuarioId])
  @@index([oficinaId, usuarioId])
}
