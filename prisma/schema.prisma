// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoCliente {
  COMPRADOR
  VENDEDOR
  INQUILINO
  PROPIETARIO
}

enum TipoInmueble {
  PISO
  CASA
  CHALET
  ATICO
  LOCAL
  GARAJE
  TERRENO
  NAVE
  OFICINA
}

enum TipoOperacion {
  VENTA
  ALQUILER
}

enum EstadoInmueble {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ALQUILADO
}

enum CategoriaArchivo {
  FOTO
  DOCUMENTO
}

// Quién vive en el inmueble. null = «Sin datos».
enum Ocupacion {
  INQUILINOS
  PROPIETARIO
  VACIO
}

enum TipoEvento {
  VISITA
  REUNION
  LLAMADA
  FIRMA
  OTRO
}

// Cita de la agenda. Puede ir ligada a un cliente y/o un inmueble; si se borra
// alguno de ellos el evento se conserva sin el enlace.
// Todo el día: inicio y fin son medianoche UTC y fin es exclusivo (como en iCal).
model Evento {
  id         String     @id @default(cuid())
  titulo     String
  tipo       TipoEvento @default(OTRO)
  inicio     DateTime
  fin        DateTime
  todoElDia  Boolean    @default(false)
  notas      String?
  clienteId  String?
  inmuebleId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  cliente  Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)

  @@index([inicio, fin])
  @@index([clienteId])
  @@index([inmuebleId])
}

// Edificio que agrupa pisos. calle + numero + localidad lo identifican de forma
// única, lo que permite hacer upsert al importar desde Excel.
model Bloque {
  id           String   @id @default(cuid())
  calle        String
  numero       String
  localidad    String
  nombre       String?
  codigoPostal String?
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inmuebles Inmueble[]

  @@unique([calle, numero, localidad])
  @@index([localidad])
}

model Cliente {
  id                   String      @id @default(cuid())
  nombre               String
  apellidos            String
  // DNI/NIE normalizado (sin espacios ni guiones, en mayúsculas). Único: sirve
  // para detectar duplicados, también al importar desde Excel.
  dni                  String?     @unique
  telefono             String?
  email                String?
  direccion            String?
  // Etiquetas del cliente: puede ser a la vez comprador, inquilino y propietario.
  tipos                TipoCliente[] @default([])
  // Obsoleto: sustituido por `tipos`. Se mantiene (igual a la primera etiqueta)
  // solo mientras la versión desplegada lo lea; se elimina tras el despliegue.
  tipoCliente          TipoCliente
  notas                String?
  fechaUltimoContacto  DateTime?
  fechaProximoContacto DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  contactos            Contacto[]
  archivos             Archivo[]
  intereses            Interes[]
  operaciones          Operacion[]
  inmueblesEnPropiedad Inmueble[]  @relation("PropietarioInmueble")
  eventos              Evento[]

  @@index([nombre])
  @@index([apellidos])
  @@index([telefono])
  @@index([email])
  @@index([tipoCliente])
  @@index([tipos], type: Gin)
  @@index([fechaProximoContacto])
}

// Un contacto puede ser con un cliente, sobre un inmueble, o ambos (p. ej. llamada
// al propietario sobre su piso): así aparece en los dos historiales sin duplicarse.
// La migración añade un CHECK que exige al menos uno de los dos.
model Contacto {
  id         String   @id @default(cuid())
  clienteId  String?
  inmuebleId String?
  fecha      DateTime @default(now())
  nota       String

  cliente  Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([inmuebleId])
  @@index([fecha])
}

model Inmueble {
  id              String         @id @default(cuid())
  referencia      String         @unique
  direccion       String
  localidad       String
  tipoInmueble    TipoInmueble
  tipoOperacion   TipoOperacion
  precio          Decimal        @db.Decimal(12, 2)
  metrosCuadrados Int?
  habitaciones    Int?
  banos           Int?
  descripcion     String?
  estado          EstadoInmueble @default(DISPONIBLE)
  propietarioId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Ubicación dentro del bloque. planta es entera para poder ordenar (0 = Bajo).
  bloqueId String?
  escalera String?
  planta   Int?
  puerta   String?

  ocupacion            Ocupacion?
  adquisicionPotencial Boolean    @default(false)
  fechaUltimoContacto  DateTime?

  propietario Cliente?    @relation("PropietarioInmueble", fields: [propietarioId], references: [id], onDelete: Restrict)
  bloque      Bloque?     @relation(fields: [bloqueId], references: [id], onDelete: Restrict)
  archivos    Archivo[]
  intereses   Interes[]
  operaciones Operacion[]
  contactos   Contacto[]
  eventos     Evento[]

  @@index([bloqueId])
  @@index([bloqueId, escalera, planta, puerta])
  @@index([ocupacion])
  @@index([adquisicionPotencial])
  @@index([fechaUltimoContacto])
  @@index([localidad])
  @@index([estado])
  @@index([tipoOperacion])
  @@index([tipoInmueble])
  @@index([propietarioId])
  @@index([localidad, estado, tipoOperacion])
}

model Interes {
  id         String   @id @default(cuid())
  clienteId  String
  inmuebleId String
  fecha      DateTime @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([inmuebleId])
}

model Operacion {
  id            String        @id @default(cuid())
  clienteId     String
  inmuebleId    String
  tipoOperacion TipoOperacion
  fecha         DateTime      @default(now())
  precioFinal   Decimal       @db.Decimal(12, 2)
  notas         String?
  createdAt     DateTime      @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([inmuebleId])
  @@index([fecha])
}

model Archivo {
  id             String           @id @default(cuid())
  categoria      CategoriaArchivo
  clienteId      String?
  inmuebleId     String?
  bucket         String
  path           String
  url            String?
  nombreOriginal String
  tamanioBytes   Int
  mimeType       String
  orden          Int              @default(0)
  createdAt      DateTime         @default(now())

  cliente  Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([inmuebleId])
  @@index([categoria])
  @@index([inmuebleId, categoria, orden])
}
