// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoCliente {
  COMPRADOR
  VENDEDOR
  INQUILINO
  PROPIETARIO
}

enum TipoInmueble {
  PISO
  CASA
  CHALET
  ATICO
  LOCAL
  GARAJE
  TERRENO
  NAVE
  OFICINA
}

enum TipoOperacion {
  VENTA
  ALQUILER
}

enum EstadoInmueble {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ALQUILADO
}

enum CategoriaArchivo {
  FOTO
  DOCUMENTO
}

model Cliente {
  id                   String      @id @default(cuid())
  nombre               String
  apellidos            String
  telefono             String?
  email                String?
  direccion            String?
  tipoCliente          TipoCliente
  notas                String?
  fechaUltimoContacto  DateTime?
  fechaProximoContacto DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  contactos            Contacto[]
  archivos             Archivo[]
  intereses            Interes[]
  operaciones          Operacion[]
  inmueblesEnPropiedad Inmueble[]  @relation("PropietarioInmueble")

  @@index([nombre])
  @@index([apellidos])
  @@index([telefono])
  @@index([email])
  @@index([tipoCliente])
  @@index([fechaProximoContacto])
}

model Contacto {
  id        String   @id @default(cuid())
  clienteId String
  fecha     DateTime @default(now())
  nota      String

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([fecha])
}

model Inmueble {
  id              String         @id @default(cuid())
  referencia      String         @unique
  direccion       String
  localidad       String
  tipoInmueble    TipoInmueble
  tipoOperacion   TipoOperacion
  precio          Decimal        @db.Decimal(12, 2)
  metrosCuadrados Int?
  habitaciones    Int?
  banos           Int?
  descripcion     String?
  estado          EstadoInmueble @default(DISPONIBLE)
  propietarioId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  propietario Cliente?    @relation("PropietarioInmueble", fields: [propietarioId], references: [id], onDelete: Restrict)
  archivos    Archivo[]
  intereses   Interes[]
  operaciones Operacion[]

  @@index([localidad])
  @@index([estado])
  @@index([tipoOperacion])
  @@index([tipoInmueble])
  @@index([propietarioId])
  @@index([localidad, estado, tipoOperacion])
}

model Interes {
  id         String   @id @default(cuid())
  clienteId  String
  inmuebleId String
  fecha      DateTime @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([inmuebleId])
}

model Operacion {
  id            String        @id @default(cuid())
  clienteId     String
  inmuebleId    String
  tipoOperacion TipoOperacion
  fecha         DateTime      @default(now())
  precioFinal   Decimal       @db.Decimal(12, 2)
  notas         String?
  createdAt     DateTime      @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([inmuebleId])
  @@index([fecha])
}

model Archivo {
  id             String           @id @default(cuid())
  categoria      CategoriaArchivo
  clienteId      String?
  inmuebleId     String?
  bucket         String
  path           String
  url            String?
  nombreOriginal String
  tamanioBytes   Int
  mimeType       String
  orden          Int              @default(0)
  createdAt      DateTime         @default(now())

  cliente  Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([inmuebleId])
  @@index([categoria])
  @@index([inmuebleId, categoria, orden])
}
